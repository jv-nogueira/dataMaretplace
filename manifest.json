{
    "manifest_version": 3,
    "name": "Extrator de anúncios do ML",
    "version": "1.0",
    "description": "Salva em planilha as informações da lista de produtos do Mercado Livre",
    "permissions": ["activeTab", "scripting", "storage"],
    "icons": { 
      "48": "icons/shopping.png"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["*://*.mercadolivre.com.br/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ],
    "host_permissions": [
      "*://*.mercadolivre.com.br/*"
    ],
    "action": {
      "default_title": "Iniciar Scraper"
    }
  }
  